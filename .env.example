# Copy to .env.local and fill in from your Supabase project (Project Settings -> API).
# Only the public URL and publishable key are used; never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Activity assistant (https://console.anthropic.com). Server-only: never prefix with NEXT_PUBLIC_.
# Without it /api/chat answers 503 and the assistant shows a "not set up yet" message.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-5-5.
# CHATBOT_MODEL=
